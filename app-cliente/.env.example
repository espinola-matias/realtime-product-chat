# Configuración web de Firebase (la misma app web que usa app-comercio)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
EXPO_PUBLIC_FIREBASE_DATABASE_URL=https://tu-proyecto-default-rtdb.firebaseio.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=tu-proyecto
EXPO_PUBLIC_FIREBASE_APP_ID=

# Mismo chatId en las tres piezas
EXPO_PUBLIC_CHAT_ID=chat-demo-001

# URL de la API NestJS:
#   Emulador Android  → http://10.0.2.2:3000
#   Simulador iOS     → http://localhost:3000
#   Teléfono físico   → http://<IP-LAN-de-tu-PC>:3000
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
