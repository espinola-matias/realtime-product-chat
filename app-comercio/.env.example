# Configuración web de Firebase (Consola → Configuración del proyecto → Tus apps → Web)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://tu-proyecto-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=tu-proyecto
VITE_FIREBASE_APP_ID=

# Mismo chatId en las tres piezas
VITE_CHAT_ID=chat-demo-001
